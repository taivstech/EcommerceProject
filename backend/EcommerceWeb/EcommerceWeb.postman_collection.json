            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverName\": \"Nguyen Van B\",\n  \"phoneNumber\": \"0909999999\",\n  \"fullAddress\": \"456 XYZ, Quan 3, HCM\",\n  \"detailAddress\": \"456 XYZ\",\n  \"ward\": \"Phuong 1\",\n  \"wardCode\": \"20401\",\n  \"district\": \"Quan 3\",\n  \"districtId\": 1443,\n  \"province\": \"Ho Chi Minh\",\n  \"provinceId\": \"202\",\n  \"defaultAddress\": false\n}"
