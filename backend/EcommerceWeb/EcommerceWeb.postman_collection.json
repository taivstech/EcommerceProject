{
  "info": {
    "name": "EcommerceWeb API",
    "description": "Full API collection for EcommerceWeb — Spring Boot backend.\nBase URL: http://localhost:8080/api\n\nAuthentication: Bearer token in Authorization header.\nLogin via POST /auth/token to get access_token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "accessToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.result && json.result.access_token) {",
                  "    pm.collectionVariables.set('accessToken', json.result.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/token", "host": ["{{baseUrl}}"], "path": ["auth", "token"] }
          }
        },
        {
          "name": "Introspect Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{accessToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/introspect", "host": ["{{baseUrl}}"], "path": ["auth", "introspect"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "Refresh token is read from HttpOnly cookie. Access token from Authorization header."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Requires Authorization header + refresh token cookie."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"reset-token-from-email\",\n  \"new_password\": \"NewPass@123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] }
          }
        },
        {
          "name": "OAuth2 - Get State",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/outbound/state", "host": ["{{baseUrl}}"], "path": ["auth", "outbound", "state"] }
          }
        },
        {
          "name": "OAuth2 - Exchange Code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"google-auth-code\",\n  \"state\": \"state-value\",\n  \"state_signature\": \"sig\",\n  \"redirect_uri\": \"http://localhost:3000/authenticate\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/outbound/authentication", "host": ["{{baseUrl}}"], "path": ["auth", "outbound", "authentication"] }
          }
        },
        {
          "name": "Register User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"Pass@123\",\n  \"confirm_password\": \"Pass@123\",\n  \"full_name\": \"New User\",\n  \"email\": \"new@example.com\",\n  \"phone\": \"0901234567\",\n  \"dob\": \"2000-01-15\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/registration", "host": ["{{baseUrl}}"], "path": ["users", "registration"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Info",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update My Profile (JSON only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"myuser\",\n  \"full_name\": \"Updated Name\",\n  \"phone\": \"0909876543\",\n  \"dob\": \"1999-05-20\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update My Profile (with avatar)",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "profile",
                  "value": "{\n  \"username\": \"myuser\",\n  \"full_name\": \"Updated Name\",\n  \"phone\": \"0909876543\",\n  \"dob\": \"1999-05-20\"\n}",
                  "type": "text",
                  "contentType": "application/json"
                },
                { "key": "file", "type": "file", "src": "", "description": "Avatar image file (optional)" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "description": "Update profile with optional avatar upload. Send 'profile' part as JSON + 'file' part as image."
          }
        },
        {
          "name": "Upgrade to Seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"shop_name\": \"My Shop\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/me/upgrade-to-seller", "host": ["{{baseUrl}}"], "path": ["users", "me", "upgrade-to-seller"] }
          }
        },
        {
          "name": "[Admin] Get All Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "[Admin] Get User By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/:id", "host": ["{{baseUrl}}"], "path": ["users", ":id"], "variable": [{ "key": "id", "value": "user-uuid" }] }
          }
        }
      ]
    },
