{
  "analysis": {
    "analyzer": {
      "product_index_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "asciifolding",
          "vietnamese_stop",
          "product_synonym",
          "word_delimiter_filter",
          "edge_ngram_filter"
        ]
      },
      "product_search_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "asciifolding",
          "vietnamese_stop",
          "product_synonym"
        ]
      },
      "suggest_index_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "asciifolding",
          "edge_ngram_filter"
        ]
      },
      "suggest_search_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "asciifolding"
        ]
      },
      "keyword_lowercase": {
        "type": "custom",
        "tokenizer": "keyword",
        "filter": [
